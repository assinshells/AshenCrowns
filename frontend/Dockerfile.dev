# --- Development image for the frontend service (Vite dev server + HMR) ---
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Source is bind-mounted by docker-compose for live reload; this COPY only
# matters if the image is run standalone without the volume mount.
COPY . .

EXPOSE 5173

# --host is required so the dev server is reachable from outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
