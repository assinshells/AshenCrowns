PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgre:root@localhost:5432/postgre
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Генерировать так: openssl rand -hex 64 (свой секрет для каждого из двух)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# В секундах, должно соответствовать JWT_REFRESH_EXPIRES_IN (TTL записи в Redis)
JWT_REFRESH_TTL_SECONDS=604800

OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_WINDOW_MS=900000