# ── Сервер ──────────────────────────────────────────────────────────────
PORT=3000
# Origin фронтенда. Используется для CORS и проверки заголовка Origin (CSRF).
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgre:root@localhost:5432/postgre
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# Число доверенных reverse-proxy перед приложением (nginx в docker/prod = 1, локально = 0).
TRUST_PROXY=0

# ── Сессии (серверные, в Redis) ─────────────────────────────────────────
# Скользящий TTL сессии в секундах (абсолютный предел — 30 суток).
SESSION_TTL_SECONDS=604800

# ── Регистрация ─────────────────────────────────────────────────────────
# true — аккаунт неактивен, пока email не подтверждён OTP-кодом.
EMAIL_VERIFICATION_REQUIRED=true

# ── OTP ─────────────────────────────────────────────────────────────────
# Секрет для HMAC хранимых кодов. Генерировать: openssl rand -hex 32  (минимум 32 символа)
OTP_SECRET=change-me-generate-with-openssl-rand-hex-32
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# ── Блокировка перебора пароля (по email) ───────────────────────────────
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ── Email ───────────────────────────────────────────────────────────────
# console — письма (с кодами!) печатаются в лог. Только для development.
# smtp    — реальная отправка; обязателен в production.
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ashen Crowns <no-reply@example.com>"

# ── Rate limit (окно в мс; значения — запросов на IP за окно) ───────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_RESEND_MAX=10
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_ACCOUNT_MAX=20
RATE_LIMIT_CHARACTER_MAX=120
RATE_LIMIT_WORK_MAX=240
